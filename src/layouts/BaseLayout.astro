---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import 'lenis/dist/lenis.css';
import '../styles/style.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description?: string;
  /** Kelas untuk elemen <main> (mis. "notfound", "achievement-page"). */
  mainClass?: string;
}

const { title, description, mainClass } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {description && <meta name="description" content={description}>}
    <title>{title}</title>

    <link rel="icon" href={url('logo.png')}>
    <meta name="theme-color" content="#014E27">
    <meta property="og:site_name" content="MANPK Jombang">
    <meta property="og:type" content="website">
    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&display=swap" rel="stylesheet">

    <!-- Tandai lebih awal agar teks hero tidak berkedip sebelum animasi; dilewati bila pengguna memilih kurangi gerak. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('has-motion');
    </script>
    <noscript><style>.reveal { opacity: 1; transform: none; }</style></noscript>
  </head>

  <body>
    <Navbar />

    <main class={mainClass}>
      <slot />
    </main>

    <slot name="after-main" />

    <Footer />

    <script>
      import '../scripts/site';
      import '../scripts/motion';
    </script>
  </body>
</html>
